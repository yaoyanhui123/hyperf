APP_NAME=product-service
APP_ENV=dev

HTTP_PORT=9512
RPC_PORT=9612
WORKER_NUM=4

JWT_SECRET=mall-dev-secret-change-me

DB_DRIVER=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=mall_product
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=host.docker.internal
REDIS_AUTH=123456
REDIS_PORT=6379
REDIS_DB=2

SERVICE_NAME=mall-product
NACOS_HOST=host.docker.internal
NACOS_PORT=8848
NACOS_NAMESPACE=mall
NACOS_GROUP=DEFAULT_GROUP
CONFIG_CENTER_ENABLE=false